library(tidyverse)
n_obs <- 100
obs_sd <- 0.8
truth <- rnorm(n_obs)
est_raw <- rnorm(n_obs, mean=truth, sd=obs_sd)
act_raw <- rnorm(n_obs, mean=truth, sd=obs_sd)
get_quantile <- function(x) {
(rank(x) - 1) * 100 / (length(x) - 1)
}
bias_quantile <- function(x, bias) {
x <- x + bias
x <- pnorm(x)
}
# Sanity check
x <- c(30, 1.1, 2.5)
get_quantile(x)
data <- data.frame(
est=bias_quantile(get_quantile(est_raw), 0.3),
act=get_quantile(act_raw))
