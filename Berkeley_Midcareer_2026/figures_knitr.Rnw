% @
% \caption{Models from \cite{gelman:2006:arm}\tablabel{arm_models}}
% \end{table}
% }


<<ottographs, cache=cache_otto>>=
source("R_scripts/logistic_otto_sim/generate_histogram_plots.R")
SetShortImageSize()
@

\def\OttoGraphZero{
%
<<>>=
figcap <- paste("A covariate shift diagnostic", sep="")
@
<<ottograph0, cache=cache_otto, fig.show='hold', fig.cap=figcap>>=
print(plot0)
@
}

\def\OttoGraphOne{
%
<<>>=
figcap <- paste("A covariate shift diagnostic", sep="")
@
<<ottograph1, cache=cache_otto, fig.show='hold', fig.cap=figcap>>=
print(plot1)
@
}


\def\OttoGraphTwo{
%
<<>>=
figcap <- paste("A covariate shift diagnostic", sep="")
@
<<ottograph2, cache=cache_otto, fig.show='hold', fig.cap=figcap>>=
print(plot2)
@
}


\def\OttoGraphThree{
%
<<>>=
figcap <- paste("A covariate shift diagnostic", sep="")
@
<<ottograph3, cache=cache_otto, fig.show='hold', fig.cap=figcap>>=
print(plot3)
@
}




<<shiftgraphs, cache=cache_otto>>=
source("R_scripts/logistic_otto_sim/generate_shift_plots.R")
SetShortImageSize()
@

\def\ShiftGraphZero{
%
<<>>=
figcap <- paste("A covariate shift diagnostic", sep="")
@
<<shiftplot0, cache=cache_otto, fig.show='hold', fig.cap=figcap>>=
print(shift_plot0)
@
}


\def\ShiftGraphOne{
%
<<>>=
figcap <- paste("A covariate shift diagnostic", sep="")
@
<<shiftplot1, cache=cache_otto, fig.show='hold', fig.cap=figcap>>=
print(shift_plot1)
@
}

<<>>=
SetFullImageSize()
@
