% fig.scap prevents math in the caption optional argument
\newcommand{\VariancePlot}{
<<>>=
figcap <- paste0("Estimates of the frequentist standard deviation of ",
                 "$\\sqrt{\\nsur} \\muhat[\\mrp]$ and ",
                 "$\\sqrt{\\nsur} \\muhat[\\cal]$")
@
<<varplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
print(var_plt)
@
}


% fig.scap prevents math in the caption optional argument
\newcommand{\BootstrapPlot}{
<<>>=
figcap <- paste0("Estimates of the frequentist standard deviation of ",
                 "$\\sqrt{\\nsur} \\muhat[\\mrp]$")
@
<<bootplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
print(boot_plt)
@
}


