<<setup, include=FALSE, cache=FALSE>>=
knitr_debug <- FALSE # Set to true to see error output

rerun_all <- TRUE

# Set to true to cache knitr output for this analysis.
cache <- TRUE && (!rerun_all)


source("figures_knitr/initialize.R", echo=FALSE)
@

<<load_data>>=
source(GetScriptLoc("load_data.R"))

@

\newcommand{\DefineMacros}{
<<define_macros, results="asis">>=
source(GetScriptLoc("define_macros.R"))
@
}




%%%%%%%%%%%%%%%%%%%%%%%


\newcommand{\YpathPlot}{
<<>>=
figcap <- paste0("Path through response space")
SetImageSize(aspect_ratio=1.3, image_width=3.0)
@
<<ypath, cache=cache, fig.show='hold', fig.pos="H">>=
print(ypath_plt)
@
<<>>=
SetFullImageSize()
@
}


