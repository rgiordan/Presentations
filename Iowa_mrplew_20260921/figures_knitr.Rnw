\newcommand{\LaxphilipsCAPoolingPlot}{
<<>>=
figcap <- paste0("Subgroup contribution for Same-Sex Marriage in California")
SetImageSize(0.3)
@
<<laxphilipscapoolingplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
MakeUSPoolingPlot(laxphilips_CA_pooling)
@
<<>>=
SetFullImageSize()
@
}


