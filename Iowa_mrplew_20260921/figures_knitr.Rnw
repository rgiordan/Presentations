<<setup, include=FALSE, cache=FALSE>>=
knitr_debug <- FALSE # Set to true to see error output

rerun_all <- TRUE

# Set to true to cache knitr output for this analysis.
cache <- TRUE && (!rerun_all)


source("figures_knitr/initialize.R", echo=FALSE)
@

<<load_data>>=
source(GetScriptLoc("load_data.R"))

@

\newcommand{\DefineMacros}{
<<define_macros, results="asis">>=
source(GetScriptLoc("define_macros.R"))
@
}


%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\IntroPlot}{
<<>>=
figcap <- paste0("Preview of MrP Diagnostics made possible by MrPlew for the Name Change analysis")
@
<<introplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
source(GetScriptLoc("intro_plot.R"), print.eval=TRUE)
@
}



% %%%%%%%%%%%%%%%%%%%%%%

\newcommand{\ExperimentTable}{
<<experimenttable, cache=cache, results='asis', echo=FALSE>>=
source(GetScriptLoc("experiment_table.R"), print.eval=TRUE)
@
}


\newcommand{\AlexanderResidualTable}{
<<alexanderresidtable, cache=cache, results='asis', echo=FALSE>>=
source(GetScriptLoc("resid_table.R"), print.eval=TRUE) 
@
}


% %%%%%%%%%%%%%%%%%%%%%%


% fig.scap prevents math in the caption optional argument
\newcommand{\VariancePlot}{
<<>>=
figcap <- paste0("Estimates of the frequentist standard deviation of ",
                 "$\\sqrt{\\nsur} \\muhat[\\mrp]$ and ",
                 "$\\sqrt{\\nsur} \\muhat[\\cal]$")
@
<<varplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
print(var_plt)
@
}


% fig.scap prevents math in the caption optional argument
\newcommand{\BootstrapPlot}{
<<>>=
figcap <- paste0("Estimates of the frequentist standard deviation of ",
                 "$\\sqrt{\\nsur} \\muhat[\\mrp]$")
@
<<bootplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
print(boot_plt)
@
}


\newcommand{\WeightsPlot}{
<<>>=
figcap <- paste0("Comparison of weights")
@
<<weightsplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
print(weight_plt)
@
}

