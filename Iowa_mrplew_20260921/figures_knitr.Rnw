figcap <- paste0("Balance")
@
<<alexanderbalanceplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="H", fig.scap="">>=
PlotBalanceForEnv(alexander, interactions=FALSE)
@
}


