get_quantile <- function(x) {
(rank(x) - 1) * 100 / (length(x) - 1)
}
bias_quantile <- function(x, bias) {
x <- x + bias
x <- 100 * pnorm((x + bias) / 100)
}
# Sanity check
x <- c(30, 1.1, 2.5)
get_quantile(x)
pnorm(est_raw)
