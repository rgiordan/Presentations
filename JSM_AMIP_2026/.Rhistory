library(tidyverse)
n_obs <- 100
obs_sd <- 0.8
truth <- rnorm(n_obs)
est_raw <- rnorm(n_obs, mean=truth, sd=obs_sd)
act_raw <- rnorm(n_obs, mean=truth, sd=obs_sd)
get_quantile <- function(x) {
(rank(x) - 1) * 100 / (length(x) - 1)
}
bias_quantile <- function(x, bias) {
x <- x + bias
x <- pnorm(x)
}
# Sanity check
x <- c(30, 1.1, 2.5)
get_quantile(x)
data <- data.frame(
est=bias_quantile(get_quantile(est_raw), 0.3),
act=get_quantile(act_raw))
reg1 <- lm(est ~ act, data)
reg2 <- lm(act ~ est, data)
esthat <- predict(reg1, data)
acthat <- predict(reg2, data)
ggplot(data) +
geom_point(aes(x=act, y=est)) +
geom_line(aes(x=act, y=esthat, color="Estimate ~ Actual")) +
geom_line(aes(x=acthat, y=est, color="Actual ~ Estimate")) +
geom_abline() +
xlab("Actual performance") + ylab("Self-estimated performance") +
expand_limits(x=0, y=0) +
expand_limits(x=100, y=100)
